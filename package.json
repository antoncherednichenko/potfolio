{
  "name": "farm-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:cv-pdf && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:cv-pdf": "node scripts/generate-cv-pdf.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check"
  },
  "dependencies": {
    "next": "16.4.3",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pdfkit": "^0.20.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
